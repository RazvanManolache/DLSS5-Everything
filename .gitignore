# Third-party/proprietary runtime files kept locally but not redistributed here
/runtime/**/*.dll
/runtime/**/*.exe
/runtime/host64/renodx-dlss5.addon64
!/runtime/host64/dlss5-feed-host64.exe
!/runtime/screen/dlss5-screen.exe

